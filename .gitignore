# Terraform working files and state (state can contain sensitive data)
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.plan
crash*.log

# Variable files with real values (commit only *.tfvars.example)
*.tfvars
*.tfvars.json

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Credentials, keys and secrets
*.pem
*.key
application_default_credentials.json
credentials*.json
*-credentials.json
service-account*.json
*-service-account.json
*-key.json
secrets*.json
*-secrets.json
.env
.env.*

# Logs, local backups and tooling
*.log
*.bak
.venv/
.checkov/

# Editors and operating system
.vscode/
.idea/
.DS_Store
Thumbs.db

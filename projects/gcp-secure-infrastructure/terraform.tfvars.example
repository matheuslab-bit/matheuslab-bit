# Copy this file to terraform.tfvars and replace the project ID.
# Do not commit terraform.tfvars or credentials.

project_id = "your-real-gcp-project-id"

region = "us-central1"
zone   = "us-central1-a"

# Optional cost-generating logging features are disabled by default.
enable_flow_logs         = false
enable_firewall_logging  = false
